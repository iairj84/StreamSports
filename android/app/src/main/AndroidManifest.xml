<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <!-- Saving the transparent logo for another launcher writes into the
         shared Pictures folder. Android 10 and later do that through
         MediaStore and need no permission; older releases still do. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <!-- In-app updates: the downloaded APK is installed through the package
         installer, which Android only allows for an app holding this. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- Not TV-only: phones/tablets can still install and run this fine. -->
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>

    <!-- Android Auto parked app: appCategory marks this as a video app for
         cars, and MainActivity's CAR_LAUNCHER category declares the car
         support. Both are inert on phones and TVs. Video is still an
         early-access category on Android Auto, so listing there is not
         guaranteed. -->
    <application
        android:label="StreamSports"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/streamsports_banner"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:appCategory="video">
        <!-- Impeller (Vulkan) crashes on startup on several budget Amlogic/Mali
             GPU drivers found in Firesticks and Android STBs — those devices
             have no Dart-level stack trace to catch since the crash happens
             below the Flutter engine, it just silently fails to launch. The
             OpenGLES-based Skia renderer this falls back to is slower but
             far more broadly compatible. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:supportsPictureInPicture="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- Required for Fire TV / Android TV launchers to list and
                     launch the app at all — without this it can install
                     silently and simply never appear or start. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
                <!-- Android Auto parked app. On Android 15 and higher,
                     Android Auto can run an activity directly on the head
                     unit, full screen, while the car reports Park, and
                     exits it as soon as the car reports motion. This is the
                     category that declares the app supports that; without
                     it Android Auto never considers the app for the car
                     display at all. Sideloaded builds do reach this path
                     when Android Auto's developer "Unknown sources" option
                     is on (unlike projection apps, which that option does
                     not admit). Whether Android Auto actually lists a video
                     app here is a separate, policy-side question. -->
                <category android:name="android.intent.category.CAR_LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name=".PlaybackForegroundService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="mediaPlayback" />
        <!-- A downloaded update is handed to the installer as a content://
             URI (never a file path), so the cache file needs a provider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
