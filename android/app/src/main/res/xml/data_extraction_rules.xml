<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup policy.

  The app holds one kind of secret: the viewer's playlist logins. Xtream and
  Stalker passwords sit in shared preferences, so no OS backup may carry them
  off the device — not to Google's cloud transport and not through a
  device-to-device migration the viewer never asked for.

  Moving a configuration between devices is the app's own job:
  Settings → Backups & transfer, which encrypts the payload and asks the
  receiving device to accept it. Everything below therefore excludes the whole
  app data set, which also keeps the unencrypted local backup files (including
  those playlist logins) out of the transport.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
