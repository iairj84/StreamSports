<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and lower (API 23–30) backup policy.

  Paired with android:allowBackup="false" in AndroidManifest.xml; kept explicit
  so a build or a vendor ROM that re-enables auto-backup still has nothing to
  carry. See data_extraction_rules.xml for why the whole data set is excluded:
  shared preferences hold the viewer's provider passwords, and moving a
  configuration between devices is the app's own encrypted transfer.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
